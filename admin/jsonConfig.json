{
    "i18n": true,
    "type": "tabs",
    "items": {
        "tabBroker": {
            "type": "panel",
            "label": "tabBroker",
            "items": {
                "brokerHeader": {
                    "type": "header",
                    "size": 4,
                    "text": "headerBroker",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "brokerText": {
                    "type": "staticText",
                    "text": "textBroker",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "port": {
                    "type": "number",
                    "label": "labelPort",
                    "help": "helpPort",
                    "min": 1,
                    "max": 65535,
                    "default": 1888,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_spacer": {
                    "type": "staticText",
                    "text": "",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "user": {
                    "type": "text",
                    "label": "labelUser",
                    "help": "helpUser",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "pass": {
                    "type": "password",
                    "label": "labelPass",
                    "help": "helpPass",
                    "hidden": "!data.user",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "tabConsumption": {
            "type": "panel",
            "label": "tabConsumption",
            "items": {
                "consumptionHeader": {
                    "type": "header",
                    "size": 4,
                    "text": "headerConsumption",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "consumptionText": {
                    "type": "staticText",
                    "text": "textConsumption",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "historyRegister": {
                    "type": "checkbox",
                    "label": "labelHistoryRegister",
                    "help": "helpHistoryRegister",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 6,
                    "xl": 6
                },
                "historyInstance": {
                    "type": "instance",
                    "adapter": "history",
                    "hidden": "!data.historyRegister",
                    "allowDeactivate": false,
                    "label": "labelHistoryInstance",
                    "help": "helpHistoryInstance",
                    "default": "history.0",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 6,
                    "xl": 6
                }
            }
        },
        "tabHelp": {
            "type": "panel",
            "label": "tabHelp",
            "items": {
                "h1": {
                    "type": "header",
                    "size": 4,
                    "text": "headerSetup",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "t1": {
                    "type": "staticText",
                    "text": "textSetup",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "h2": {
                    "type": "header",
                    "size": 5,
                    "text": "headerDocker",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "t2": {
                    "type": "staticText",
                    "text": "textDocker",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "h3": {
                    "type": "header",
                    "size": 5,
                    "text": "headerLive",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "t3": {
                    "type": "staticText",
                    "text": "textLive",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
